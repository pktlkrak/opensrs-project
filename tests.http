@host = http://localhost:9998

POST {{host}}/register
Content-Type: application/x-www-form-urlencoded

name=alice&password=secret1&confirmPassword=secret1

### Login
POST {{host}}/login
Content-Type: application/x-www-form-urlencoded

name=alice&password=secret1

### Login (default)
POST {{host}}/login
Content-Type: application/x-www-form-urlencoded

name=root&password=P@ssword

### Change own password
POST {{host}}/management/changepw
Content-Type: application/x-www-form-urlencoded

username=alice&current=secret1&password=secret2

###
POST {{host}}/management/initSetForUser/wk.set/0


### 
POST {{host}}/api/images/upload
Content-Type: image/png

< profile.png

###

GET {{host}}/api/images/list

### Get an image by its ID
GET {{host}}/api/images/1

### 
POST {{host}}/api/user/assignimage?set=wk.set&imageid=1

### Get the picture assigned in a set
GET {{host}}/api/user/pic?set=wk.set

### Get the first assigned picture
GET {{host}}/api/user/pic
