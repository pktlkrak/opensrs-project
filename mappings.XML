<?xml version="1.0"?>
<bindings>
    <root>en/index.html</root>
    <transformers>
        <layer tag="translate-root" apply="Translate">
            <locale>pl</locale>
            <locale>en</locale>
        </layer>
    </transformers>

    <mappings>
        <!-- Do not leave placeholders - fallback to english strings -->
        <mime localextension="html" tag="translate-root translate-lang-default-en">text/html</mime>
        <mime localextension="js" tag="translate-root translate-lang-default-en">application/javascript</mime>

        <mime localextension="png">image/png</mime>
        <mime localextension="htm">test/html</mime>
        <mime localextension="jpg">image/jpeg</mime>
        <mime localextension="jpeg">image/jpeg</mime>
        <mime localextension="gif">image/gif</mime>
        <mime localextension="css">text/css</mime>
        <mime localextension="svg">image/svg+xml</mime>
    </mappings>

    <routing>
        <bind target="$2.$3" type="regex" source="^(pl|en)/([^\.]+).(html|js|css)" tag="translate-lang-$1" />
    </routing>
</bindings>
