<html lang="en">

<head>

    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <title>WaniKani / Reviews</title>

    <link rel="stylesheet" media="screen"
        href="assets/application-147c13d8f8493ebd0be2b6e5f2f83b9f95f8fcdfe207b77f81574450a1395fca.css">
        <link rel="stylesheet" media="screen" href="assets/application-44ebe0b19e1ef0219c7fb2bd256bab0fc01c004312a7c73da60e726b408564c8.css">
    <link rel="stylesheet" media="screen" href="assets/additionals.css">
    <link rel="stylesheet" media="screen" href="assets/lesson-3189d49d.css">
    <link rel="stylesheet" href="assets/osrs-overrides.css">
    <meta name="application-name" content="WaniKani">
    <meta name="author" content="tofugu.com">
    <meta name="description"
        content="WaniKani is a Japanese radicals, kanji, and vocabulary learning web app that uses mnemonics and SRS to make kanji learning simple.">
    <meta name="keywords"
        content="japanese kanji, japanese language, japanese learning, kanji, radicals, kanji radicals, japanese vocabulary, vocabulary, srs, spaced repetition, mnemonics, memory tricks, web app">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="google" value="notranslate">
    <!-- Open Graph data -->
    <meta content="Learn Japanese kanji the effective way!" property="og:description">
    <meta content="en_US" property="og:locale">
    <meta content="WaniKani" property="og:site_name">
    <meta content="WaniKani, a kanji learning application by Tofugu" property="og:title">
    <meta content="website" property="og:type">
    <meta content="https://wanikani.com/" property="og:url">
    <meta content="https://www.tofugu.com" property="og:see_also">
    <!-- Twitter Card data -->
    <meta content="summary_large_image" name="twitter:card">
    <meta content="@tofugu" name="twitter:creator">
    <meta content="Learn Japanese kanji the effective way!" name="twitter:description">
    <meta content="@wanikaniapp" name="twitter:site">
    <meta content="WaniKani, a kanji learning application by Tofugu" name="twitter:title">
    <link rel="shortcut icon" type="image/png" href="assets/wanikani-icon-196x.png" sizes="196x196">
    <link href="https://fonts.googleapis.com/css?family=Noto+Sans+JP:400,700&amp;display=swap&amp;subset=japanese"
        rel="stylesheet">

    <link href="//fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,700" rel="stylesheet" type="text/css">
    <link href="https://maxcdn.bootstrapcdn.com/font-awesome/3.2.1/css/font-awesome.min.css" rel="stylesheet"
        type="text/css">

    <script src="/osrs.js"></script>
    <script src="assets/dark-theme.js" defer></script>
    <script src="assets/wanakana.js"></script>
    <script src="/explode.js"></script>
    <script src="assets/explodemodules.js"></script>
    <script type="text/javascript" src="js/page-activity.js" defer></script>
    <link href="assets/explode.css" rel="stylesheet" type="text/css">
<body>
  {embed:modules/toggle-dark.html}

    <div id="loading" style="display: none;"></div>

    <div id="screen-quiz-ready" class="screen-overlay hidden noSwipe">
        <div>
            <div>
                <h1>Now that you have learned <span></span> new items, it is time to quiz you on the material</h1>
                <ul class="btn-set">
                    <li id="quiz-ready-read-lessons"><i class="icon-arrow-left"></i> Need more time</li>
                    <li id="quiz-ready-continue" class="dominant">Start the quiz<i class="icon-arrow-right"></i></li>
                </ul>
            </div>
        </div>
    </div>
    <div id="screen-lesson-ready" class="screen-overlay hidden noSwipe">
        <div>
            <div>
                <h1>Good job! The items you have just finished quizzing on have been moved to your review
                    queue.<br><br>Do you
                    wish to continue on with the lessons?</h1>
                <ul class="btn-set">
                    <li id="lesson-ready-done"><i class="icon-arrow-left"></i>I'm done for now</li>
                    <li id="lesson-ready-continue" class="dominant">Continue with new lessons<i
                            class="icon-arrow-right"></i>
                    </li>
                </ul>
            </div>
        </div>
    </div>
    <div id="screen-lesson-done" class="screen-overlay hidden noSwipe">
        <div>
            <div>
                <h1>Good job! The items you have just finished quizzing on have been moved to your review
                    queue.<br><br>And it
                    looks like you have completed all your lessons. Congrats!</h1>
                <ul class="btn-set">
                    <li id="lesson-ready-end"><i class="icon-arrow-left dominant"></i>View summary</li>
                </ul>
            </div>
        </div>
    </div>

    <div id="lessons" style="display: none;">
        <div class="pure-u-1">
            <div id="lesson-stats">
                <ul>
                    <li id="lesson-radical-count" title="Number of radical lessons">R<span class="vocabulary">0</span></li>
                    <li id="lesson-kanji-count" title="Number of kanji lessons">K<span class="vocabulary">0</span></li>
                    <li id="lesson-vocabulary-count" title="Number of vocabulary lessons">V<span class="vocabulary">7</span>
                    </li>
                    <li id="lesson-completed-count" title="Number of completed lessons this session">0</li>
                </ul>
            </div>
            <header>
                <div id="main-info" class="vocabulary">
                    <div id="lesson-character" lang="ja">フェチング...</div>
                    <div id="meaning">Fetching...</div>
                </div>
            </header>
            <div id="lesson">
                <div id="supplement-nav" class="noSwipe dark-filter-exclude">
                    <ul>
                    </ul>
                </div>
                <div id="supplement-info">
                    <div id="prev-btn" class="noSwipe"></div>
                    <div id="next-btn" class="noSwipe"></div>
                    <div id="supplement-voc">
                        <div id="supplement-voc-breakdown">

                        </div>
                    </div>
                </div>
                <div id="batch-items" class="noSwipe bottom">
                    <ul>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <div id="reviews" class="pure-g-r" style="display: none;">
        <div class="pure-u-1">
            <div id="question">
                <div id="summary-button"><a title="Go to summary page" href="/review"><i class="icon-home"></i></a>
                </div>
                <div id="review-stats-l">
                    <i class="icon-thumbs-up"></i><span id="review-correct-rate">?</span> <i class="icon-ok"></i><span
                        id="review-completed-count">?</span> <i class="icon-inbox"></i><span id="review-available-count">?</span>
                </div>
                <div id="review-character" class="vocabulary" lang="ja">
                    <span lang="ja">フェチング...</span>
                </div>
                <div id="question-type" class="reading">
                    <h1>Fetching...</h1>
                </div>
                <div id="answer-form">
                    <form>
                        <fieldset class="">
                            <input autocapitalize="none" autocomplete="off" autocorrect="off" spellcheck="false"
                                id="user-response" name="user-response" placeholder="答え" type="text" lang="ja">
                            <button><i class="icon-chevron-right"></i></button>
                        </fieldset>
                    </form>
                </div>
            </div>
            <div data-react-class="AdditionalInformation/Options"
                data-react-props="{&quot;audioAutoPlay&quot;:false,&quot;preferredVoiceActor&quot;:1,&quot;isReview&quot;:true}"
                data-hydrate="t" data-react-cache-id="AdditionalInformation/Options-0" id="additional-content">
                <ul data-reactroot="">
                    <li id="option-wrap-up"><span title="Wrap Up"><strong id="wrap-up-countdown"></strong><i
                                class="icon-time"></i></span></li>
                    <li id="option-last-items"><span title="Last 10"><i class="icon-ok"></i></span></li>
                    <li id="option-item-info" class="disabled"><span title="Item Info"><i
                                class="icon-eye-open"></i></span></li>
                    <li id="option-kana-chart"><span title="Kana Chart"><i class="icon-hkana-list"></i></span></li>
                    <li id="option-audio" class="new-audio disabled"><span title="Pronunciation"><button
                                id="option-audio-player" disabled="" type="button" class="audio-btn audio-idle"
                                title="Audio unavailable"></button></span></li>
                </ul>
            </div>
            <div id="information">
                <div id="additional-content-load"></div>

                <div id="information-offline">
                    <i class="icon-warning-sign"></i> Can't retrieve data due to connection issues. Refresh by
                    reaccessing this tab.
                </div>

                {embed:modules/kana-chart.html}

                <div id="item-info">
                    <!--<div class="pure-g-r">
                        <div class="pure-u-1-4" id="item-info-col1"></div>
                        <div class="pure-u-3-4" id="item-info-col2"></div>
                    </div>
                    <div id="all-info">
                        <i class="icon-chevron-down"></i> Show All Information
                    </div>-->
                </div>

                <div id="last-items">
                    <div id="last-items-list" class="pure-g-r">
                        <div class="pure-u-1">
                            <ul></ul>
                        </div>
                    </div>
                </div>

            </div>

            <footer>
                <div id="hotkeys" title="Keyboard Shortcuts" class="pure-hidden-tablet">
                    <div id="hotkeys-header">
                        <a href="#"><i class="icon-keyboard"></i> <span>Hotkeys</span></a>
                    </div>
                    <table>
                        <tbody>
                            <tr>
                                <td><span>F</span></td>
                                <td>Item Info</td>
                            </tr>
                            <tr>
                                <td><span>SPACEBAR</span></td>
                                <td>Display Hidden Item Info</td>
                            </tr>
                            <tr>
                                <td><span>J</span></td>
                                <td>Audio Pronunciation</td>
                            </tr>
                            <tr>
                                <td><span>/</span></td>
                                <td>Hiragana IME Chart</td>
                            </tr>
                            <tr>
                                <td><span>,</span></td>
                                <td>Last Session Data</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </footer>
        </div>
    </div>
</body>

</html>
