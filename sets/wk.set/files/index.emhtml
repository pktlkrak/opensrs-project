<!DOCTYPE html>
<html lang="en" id="main">

<head>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
  <title>WaniKani / Dashboard</title>
  <link rel="stylesheet" media="screen"
    href="assets/application-9bcb6abc8647c5e79b96f38c958be7e9ee0758f5299fb53f.css" />
  <link rel="stylesheet" media="screen"
    href="assets/application-be8fec0c87a2d6cf9afb39f298ad7f72f89c7f1d741153bd.css" />
  <link rel="stylesheet" media="screen" href="assets/application-07e4a557.css" />
  <link rel="stylesheet" media="screen" href="assets/additionals.css" />

  <meta name="application-name" content="WaniKani">
  <meta name="author" content="tofugu.com">
  <meta name="description"
    content="WaniKani is a Japanese radicals, kanji, and vocabulary learning web app that uses mnemonics and SRS to make kanji learning simple.">
  <meta name="keywords"
    content="japanese kanji, japanese language, japanese learning, kanji, radicals, kanji radicals, japanese vocabulary, vocabulary, srs, spaced repetition, mnemonics, memory tricks, web app">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="google" value="notranslate">
  <link rel="shortcut icon" type="image/png" href="assets/wanikani-icon-196x.png" sizes="196x196" />
  <link href="https://fonts.googleapis.com/css?family=Noto+Sans+JP:400,700&display=swap&subset=japanese"
    rel="stylesheet">

  <link href='https://fonts.googleapis.com/css?family=Open+Sans:300,400,600,700' rel='stylesheet' type='text/css'>
  <link href='https://fonts.googleapis.com/css?family=Ubuntu:300,700,300italic,700italic' rel='stylesheet'
    type='text/css'>
  <link href='https://maxcdn.bootstrapcdn.com/font-awesome/3.2.1/css/font-awesome.min.css' rel='stylesheet'
    type='text/css'>
  <script src="assets/depends.js"></script>
  <script src="assets/nav.js" defer></script>
  <script src="assets/dark-theme.js" defer></script>
  <script src="assets/utils.js"></script>
  <script src="/osrs.js"></script>
</head>

<body>
  <~ embed modules/toggle-dark.html ~>

  <div class="footer-adjustment">
    <~ embed modules/global-header.html ~>

    <div class="dashboard">
      <div class="container">
        <div class="row">
          <div class="span12">
            <div class="progress-and-forecast">
              <section class="lessons-and-reviews">
                <ul>
                  <li>
                    <a class="lessons-and-reviews__button lessons-and-reviews__lessons-button dark-filter-exclude" href="lesson">
                      Lessons <span data-insertValue="lessonsAmount">Fetching...</span>
                    </a> </li>
                  <li>
                    <a class="lessons-and-reviews__button lessons-and-reviews__reviews-button dark-filter-exclude" href="review">
                      Reviews <span data-insertValue="reviewsAmount">Fetching...</span>
                    </a> </li>
                </ul>
              </section>
              <section class="dashboard-progress">
                <div>
                  <div class="progress-component">
                    <h1 class="text-xl leading-normal font-medium text-dark-gray m-0">Level <span
                        data-insertValue="level"></span> Progress</h1>
                    <div class="-mx-6 mb-3 p-3 relative">
                      <div class="progress-bar w-full h-9 boxshadow-inset relative bg-gray-300">
                        <div id="mainKanjiProgress" class="progress-bar__progress bg-pink-gradient left-0 absolute"
                          style="width: 0%; min-width: 36px;"></div>
                        <div id="mainKanjiProgressLabel" class="progress-bar__label font-sans absolute"
                          style="display: inline-block; padding-left: 10px;"><span
                            data-insertValue="passedKanji"></span> of <span data-insertValue="allKanji"></span>
                          <span class="progress-bar__extra-label">kanji passed</span></div>
                      </div>
                    </div>
                    <div class="rounded bg-white p-3 -mx-3 mt-3">
                      <h2
                        class="border-gray-100 border-solid border-0 border-b text-sm text-black text-left leading-none tracking-normal font-bold mt-0 pb-2 mb-2">
                        Radicals</h2>
                      <div class="progress-entries" id="radicalsList">
                      </div>
                    </div>
                    <div class="rounded bg-white p-3 -mx-3 mt-3">
                      <h2
                        class="border-gray-100 border-solid border-0 border-b text-sm text-black text-left leading-none tracking-normal font-bold mt-0 pb-2 mb-2">
                        Kanji</h2>
                      <div class="progress-entries" id="kanjiList">
                      </div>
                    </div>
                  </div>
                </div>
              </section>
              <section data-react-class="ReviewForecast/ReviewForecast"
                data-react-props="{&quot;forecast&quot;:{&quot;2021-08-25T08:00:00Z&quot;:4,&quot;2021-08-25T14:00:00Z&quot;:2,&quot;2021-08-25T21:00:00Z&quot;:5,&quot;2021-08-25T22:00:00Z&quot;:6,&quot;2021-08-26T00:00:00Z&quot;:9,&quot;2021-08-26T23:00:00Z&quot;:3,&quot;2021-08-27T23:00:00Z&quot;:10,&quot;2021-08-28T09:00:00Z&quot;:9,&quot;2021-08-28T23:00:00Z&quot;:1,&quot;2021-08-29T21:00:00Z&quot;:4,&quot;2021-08-29T22:00:00Z&quot;:16,&quot;2021-08-30T12:00:00Z&quot;:17,&quot;2021-08-30T22:00:00Z&quot;:5,&quot;2021-08-31T21:00:00Z&quot;:6,&quot;2021-08-31T22:00:00Z&quot;:9,&quot;2021-09-01T22:00:00Z&quot;:3},&quot;subjectCount&quot;:9148,&quot;startedCount&quot;:339,&quot;burnedCount&quot;:0,&quot;isOnVacation&quot;:false,&quot;nextAvailableAtAfterForecast&quot;:&quot;2021-09-04T09:00:00Z&quot;,&quot;reviewCount&quot;:33,&quot;lessonCount&quot;:12}"
                data-react-cache-id="ReviewForecast/ReviewForecast-0" class="forecast flex flex-col"></section>
            </div>

            <section class="srs-progress mb-30">
              <ul>
                <li id="apprentice" rel="popover-srs" title="<div class='srs-logo apprentice'></div>">
                  <span>Fetching...</span>
                  Apprentice
                </li>
                <li id="guru" rel="popover-srs" title="<div class='srs-logo guru'></div>">
                  <span>Fetching...</span>
                  Guru
                </li>
                <li id="master" rel="popover-srs" title="<div class='srs-logo master'></div>">
                  <span>Fetching...</span>
                  Master
                </li>
                <li id="enlightened" rel="popover-srs" title="<div class='srs-logo enlightened'></div>">
                  <span>Fetching...</span>
                  Enlightened
                </li>
                <li id="burned" rel="popover-srs" title="<div class='srs-logo burned'></div>">
                  <span>Fetching...</span>
                  Burned
                </li>
              </ul>
            </section>

            <div class="row">
              <div class="span4">
                <section class="recent-unlocks kotoba-table-list dashboard-sub-section">
                  <h3 class="small-caps">New Unlocks In The Last 30 Days</h3>
                  <table>
                    <tbody>
                      <tr class="none-available">
                        <td>
                          <div><i class="icon-code"></i></div>I am not implementing this yet.
                        </td>
                      </tr>
                    </tbody>
                  </table>
                  <div class="see-more">
                    <a class="small-caps" href="/recent-unlocks">
                      <!--See More Unlocks...--></a>
                  </div>
                </section>
              </div><!-- span4 -->
              <div class="span4">
                <section class="low-percentage kotoba-table-list dashboard-sub-section">
                  <h3 class="small-caps">Critical Condition Items</h3>
                  <table>
                    <tbody>
                      <tr class="none-available">
                        <td>
                          <div><i class="icon-code"></i></div>I am not implementing this yet.
                        </td>
                      </tr>
                    </tbody>
                  </table>
                  <div class="see-more">
                    <a class="small-caps" href="/"></a>
                  </div>
                </section>
              </div><!-- span4 -->
              <div class="span4">
                <section class="recent-retired kotoba-table-list dashboard-sub-section">
                  <h3 class="small-caps">Burned Items In The Last 30 Days</h3>
                  <table>
                    <tbody>
                      <tr class="none-available">
                        <td>
                          <div><i class="icon-code"></i></div>I am not implementing this yet.
                        </td>
                      </tr>
                    </tbody>
                  </table>
                  <div class="see-more">
                    <a class="small-caps" href="/"></a>
                  </div>
                </section>
              </div><!-- span4 -->
            </div><!-- row -->
          </div><!-- span12 -->
        </div><!-- row -->
      </div><!-- container -->
    </div><!-- dashboard -->



    <div class="footer-push"></div>
  </div>
  <footer>
    <div class="container">
      <div class="row">
        <div class="span12">
          <ul>
            <li>
              <a href="/about">About</a>
            </li>
            <li>
              Copyright © Tofugu LLC, <span lang="ja">よ</span> (Modified to use OpenSRS)
            </li>
          </ul>
        </div>
      </div>
    </div>
  </footer>

  <script type="text/javascript">
    $(document).ready(function () {
      const fillIn = (n, v) => document.querySelectorAll(`[data-insertValue='${n}']`).forEach(n => n
        .innerText = v);
      (async () => {
        const userInfo = await OSRS.getUser();
        if (userInfo.uid == -1) {
          OSRS.redirectToLogin();
          return;
        }
        fillIn("username", userInfo.username);
        const currentStatus = await OSRS.getUserStatus();
        const currentLesson = await OSRS.getLessonsQueue();
        const currentReview = await OSRS.getReviewsQueue();
        const currentItems = await OSRS.getLevelItems(currentStatus.level);

        let srsCounts = {
          "apprentice": {
            "radicals": 0,
            "kanji": 0,
            "vocabulary": 0,
            "total": 0
          },
          "guru": {
            "radicals": 0,
            "kanji": 0,
            "vocabulary": 0,
            "total": 0
          },
          "master": {
            "radicals": 0,
            "kanji": 0,
            "vocabulary": 0,
            "total": 0
          },
          "enlighten": {
            "radicals": 0,
            "kanji": 0,
            "vocabulary": 0,
            "total": 0
          },
          "burned": {
            "radicals": 0,
            "kanji": 0,
            "vocabulary": 0,
            "total": 0
          }
        }

        fillIn("level", currentStatus.level);


        for (let familyName in currentStatus.counts) {
          for (let id in currentStatus.counts[familyName]) {
            let subObject = srsCounts[Object.keys(srsCounts)[currentStatus.counts[familyName][id] - 1]];
            subObject.total += 1;
            subObject[familyName == "radical" ? "radicals" : familyName] += 1;
          }
        }

        function createProgressEntry(n) {
          const root = document.createElement("div");
          root.className = "progress-entry relative rounded-tr rounded-tl";
          const link = document.createElement("a");
          link.href = `/${OSRS.getCurrentSetName()}/${n.family}/${n.query}`;
          link.lang = "ja";
          link.className = `${n.family}-icon` + (n.rawStage === 0 && currentLesson.queue.filter(m => m.id === n.id).length === 0 ? ` ${n.family}-icon--locked` : ``);
          if (n.query.includes("images/")) {
            const img = document.createElement("img");
            img.src = n.query;
            img.alt = n.query;
            link.appendChild(img);
          } else {
            const s = document.createElement("span");
            s.innerText = n.query;
            link.appendChild(s);
          }
          const stage = Math.min(5, n.rawStage);
          const progressBar = document.createElement("div");
          progressBar.className = "progress-entry__pips w-full flex flex-row";
          for (let i = 0; i < 5; i++) {
            let className = "h-1 w-1/5 mr-px ";
            className += stage > i ? "bg-green " : "bg-gray-300 ";
            if (i === 0) {
              className += "rounded-l";
            } else if (i === 4) {
              className += "rounded-r"
            }
            const elem = document.createElement("div");
            elem.className = className;
            progressBar.appendChild(elem);
          }
          root.appendChild(link);
          root.appendChild(progressBar);
          return root;
        }

        const radicalsProgress = document.querySelector("#radicalsList");
        const kanjiProgress = document.querySelector("#kanjiList");
        currentItems.filter(n => n.family === "radical").forEach(n => radicalsProgress.appendChild(
          createProgressEntry(n)));

        const kanjis = currentItems.filter(n => n.family === "kanji");
        kanjis.forEach(n => kanjiProgress.appendChild(createProgressEntry(n)));
        const kanjisPassed = kanjis.filter(n => n.rawStage >= 5).length;

        fillIn("passedKanji", kanjisPassed);
        fillIn("allKanji", kanjis.length);

        const progress = (100.0 * kanjisPassed) / kanjis.length;

        if (kanjisPassed === 0) {
          document.querySelector("#mainKanjiProgress").remove();
        } else {
          const progressBar = document.querySelector("#mainKanjiProgress");
          progressBar.style.width = `${progress}%`;
          const label = document.querySelector("#mainKanjiProgressLabel");
          //if (progress > 20) {
            label.style.maxWidth = "calc(100% - 54px)";
            label.style.textAlign = "right";
            label.style.right = `calc(${100-progress}% + 36px)`;
            label.style.paddingLeft = "0";
            label.style.display = "";
            label.parentElement.classList.add("text-white");
          //}
        }



        // Fills in SRS counts
        Counts.fillInSrsCount(srsCounts);

        //Lessons / Reviews amount
        const minimumThresh = [500, 250, 100, 50, 25, 1, 0];
        const getMin = e => {
          let i = -1;
          while (e < minimumThresh[++i]);
          return minimumThresh[i];
        }

        const lessonsAmount = Object.keys(currentLesson.count).map(n => currentLesson.count[n]).reduce((a, b) =>
          a + b, 0);
        document.querySelectorAll("[data-insertValue='lessonsAmount']").forEach(n => n.innerText =
          lessonsAmount);
        document.querySelectorAll(".lessons-and-reviews__lessons-button").forEach(n => n.classList.add(
          "lessons-and-reviews__lessons-button--" + getMin(lessonsAmount)));

        const reviewsAmount = Object.keys(currentReview.count).map(n => currentReview.count[n]).reduce((a, b) =>
          a + b, 0);
        document.querySelectorAll("[data-insertValue='reviewsAmount']").forEach(n => n.innerText =
          reviewsAmount);
        document.querySelectorAll(".lessons-and-reviews__reviews-button").forEach(n => n.classList.add(
          "lessons-and-reviews__reviews-button--" + getMin(reviewsAmount)));


      })();


      // Replace dates with fuzzy dates
      DateTime.activateFuzzyDate();
      DateTime.activateRelativeDate();

      // SRS popover
      InfoTip.popoverSrs();

      // Message Status
      //Dashboard.messageStatus();
    });
  </script>
</body>

</html><!-- html -->
